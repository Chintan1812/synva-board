# Copy to .env.local and fill in. .env.local is gitignored.
#
# Every value here already exists in the website repo's .env.local — this repo
# needs four of them. Fastest way to populate:
#
#   grep -E '^(NEXT_PUBLIC_SUPABASE_URL|NEXT_PUBLIC_PUBLISHABLE_KEY|SUPABASE_ACCESS_TOKEN|SUPABASE_PROJECT_REF)=' \
#     "../Synva Webiste - 2.0/.env.local" > .env.local

# ── Supabase, for the board generators ────────────────────────────────────────
# READ-ONLY: the publishable/anon key only. This repo never writes to the DB —
# it is shared with the website AND the consultation app.
# (SUPABASE_URL / SUPABASE_ANON_KEY also work, if you prefer the cleaner names.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_PUBLISHABLE_KEY=

# ── Supabase, for the agent's MCP server (scripts/supabase-mcp.sh) ────────────
# A personal access token from https://supabase.com/dashboard/account/tokens.
# The MCP starts with --read-only; keep it that way.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# ── Optional ──────────────────────────────────────────────────────────────────
# Where the Synva website repo lives. Only needed if it is NOT the sibling folder
# "Synva Webiste - 2.0". Boards read brand assets + design context from it live.
# SYNVA_WEB_REPO=/absolute/path/to/Synva Webiste - 2.0
